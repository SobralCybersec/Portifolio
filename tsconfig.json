{
  "compilerOptions": {
    "target": "ES2022",

    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],

    "allowJs": false,

    "skipLibCheck": true,

    "strict": true,

    "noEmit": true,

    "incremental": true,

    "tsBuildInfoFile": ".next/cache/tsbuildinfo.json",

    "esModuleInterop": true,

    "module": "esnext",

    "moduleResolution": "bundler",

    "resolveJsonModule": true,

    "isolatedModules": true,

    "jsx": "preserve",

    "plugins": [
      {
        "name": "next"
      }
    ],

    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },

  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "coverage",
    "__tests__"
  ]
}