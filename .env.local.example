# Admin Access (Development Only)
# Set to 'true' to enable admin routes
NEXT_PUBLIC_ENABLE_ADMIN=false

# Admin Secret Token (change this!)
ADMIN_SECRET_TOKEN=your-secret-token-here-change-me

# Translation API - Choose one:
# Option 1: MyMemory (Free, 5000 words/day, no auth)
# No configuration needed - works out of the box

# Local blog translation via llama.cpp
LLAMA_MODEL=translategemma:4b
LLAMA_MODEL_PATH=models/translategemma-4b-it.Q8_0.gguf
LLAMA_SERVER_URL=http://127.0.0.1:8080
LLAMA_SERVER_BIN=/usr/lib/ollama/llama-server
LLAMA_DEVICE=CUDA0
LLAMA_GPU_LAYERS=all
LLAMA_SPLIT_MODE=none
LLAMA_CTX_SIZE=4096
LLAMA_BATCH_SIZE=512
LLAMA_UBATCH_SIZE=512
LLAMA_THREADS=6
LLAMA_THREADS_BATCH=6
LLAMA_FIT=on
LLAMA_FIT_TARGET=1024
LLAMA_FLASH_ATTN=on

# Option 2: Gemini API (Free tier available)
# Get yours at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key-here
