# Public Environment Variables (prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=LO Portfolio
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com

# Social Media Links
NEXT_PUBLIC_GITHUB_URL=https://github.com/yourusername
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/yourusername
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/yourusername

# GitHub API Token (Server-side only - DO NOT prefix with NEXT_PUBLIC_)
# Create at: https://github.com/settings/tokens
# Required scopes: public_repo (read-only)
# Rate limit: 5,000 requests/hour (authenticated) vs 60 requests/hour (unauthenticated)
GITHUB_TOKEN=your_github_personal_access_token_here

# YouTube Background Music (Server-side only)
# YouTube video URL to play as background music on page load
YOUTUBE_BACKGROUND_MUSIC=https://www.youtube.com/watch?v=qB2rMhn2epE
