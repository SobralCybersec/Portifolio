    "@tiptap/react": "^3.30.6",
    "@tiptap/starter-kit": "^3.30.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "1.38.3",
    "@vercel/analytics": "^2.0.1",
    "d3-hierarchy": "^3.1.2",
    "framer-motion": "^11.18.2",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "js-scroll-effect-module": "^0.13.5",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.577.0",
    "negotiator": "^1.1.0",
    "next": "16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.1",
    "next-themes": "npm:@teispace/next-themes@^3.0.0",
    "pusher": "5.3.4",
    "pusher-js": "8.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
