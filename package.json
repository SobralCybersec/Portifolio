{
  "name": "solo-leveling-docs",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "node scripts/qa/start-production.mjs",
    "lint": "eslint .",
    "test": "pnpm run test:jest && pnpm run test:vitest && pnpm run test:browser && pnpm run test:playwright",
    "test:jest": "jest --runInBand",
    "test:vitest": "vitest run --config vitest.config.mts",
    "test:browser": "vitest run --config vitest.browser.config.mts",
    "test:playwright": "playwright test --project=chromium --project=chromium-e2e --project=chromium-mobile --project=firefox",
    "test:playwright:all": "playwright test",
    "test:video": "playwright test tests/video --project=video && pnpm run convert:video",
    "convert:video": "node scripts/qa/convert-playwright-video.mjs",
    "test:e2e": "playwright test tests/e2e --project=chromium-e2e --project=chromium-mobile --project=firefox",
    "test:e2e:all": "playwright test tests/e2e",
    "test:accessibility": "playwright test tests/accessibility",
    "test:visual": "playwright test tests/visual --project=chromium",
    "test:visual:update": "playwright test tests/visual --project=chromium --update-snapshots",
    "test:lighthouse": "pnpm run build && pnpm exec lhci autorun && pnpm run test:lighthouse:screenshots",
    "test:lighthouse:screenshots": "node scripts/qa/capture-lighthouse-screenshots.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:scripts": "node --test \"scripts/tests/*.node-test.mjs\"",
    "docs:check": "node scripts/tests/check-docs.mjs",
    "test:coverage": "jest --runInBand --coverage",
    "test:all": "pnpm run test:coverage && pnpm run test:scripts && pnpm run docs:check",
    "full:tests": "pnpm run test && pnpm run test:scripts && pnpm run test:video",
    "quality:files": "node scripts/tests/check-file-size.mjs src",
    "quality:jscpd": "node scripts/tests/jscpd.mjs src --reporters console,json,sarif --min-lines 50 --min-tokens 100 --output reports/quality/jscpd --metrics reports/quality/jscpd-metrics.json",
    "quality:benchmark": "node scripts/tests/benchmark.mjs",
    "quality:report": "pnpm run quality:benchmark && node scripts/tests/quality-review.mjs src --coverage coverage/lcov.info --test-report reports/junit.xml --coverage-min 90 --require-tools --require-evidence",
    "quality": "pnpm run quality:report",
    "quality:full": "pnpm run docs:check && pnpm run lint && pnpm run test:all && pnpm run quality:report && pnpm run build",
    "test:watch": "jest --watch",
    "docs": "ctx7",
    "analyze": "ANALYZE=true next build",
    "vercel-build": "next build",
    "blog:new": "node scripts/blog/new.mjs",
    "blog:translate": "node scripts/blog/translate.mjs",
    "blog:validate": "node scripts/blog/validate.mjs",
    "blog:publish": "node scripts/blog/publish.mjs",
    "blog:auto": "node scripts/blog/auto.mjs"
  },
  "dependencies": {
    "@fontsource/codystar": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/teko": "^5.3.0",
    "@formatjs/intl-localematcher": "^0.8.13",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.3",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tiptap/extension-code-block-lowlight": "^3.30.6",
