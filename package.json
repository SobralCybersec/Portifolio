{
  "name": "solo-leveling-docs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "test:scripts": "node --test \"scripts/tests/*.node-test.mjs\"",
    "test:coverage": "jest --runInBand --coverage",
    "test:all": "npm run test:coverage && npm run test:scripts",
    "quality:files": "node scripts/tests/check-file-size.mjs src",
    "quality:jscpd": "node scripts/tests/jscpd.mjs src --reporters console,json,sarif --min-lines 50 --min-tokens 100 --output reports/quality/jscpd --metrics reports/quality/jscpd-metrics.json",
    "quality:benchmark": "node scripts/tests/benchmark.mjs",
    "quality:report": "npm run quality:benchmark && node scripts/tests/quality-review.mjs src --coverage coverage/lcov.info --test-report reports/junit.xml --coverage-min 90 --require-tools --require-evidence",
    "quality": "npm run quality:report",
    "quality:full": "npm run lint && npm run test:all && npm run quality:report && npm run build",
    "test:watch": "jest --watch",
    "docs": "ctx7",
    "analyze": "ANALYZE=true next build",
    "vercel-build": "next build"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.8.13",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tiptap/extension-code-block-lowlight": "^3.30.3",
    "@tiptap/extension-image": "^3.30.3",
    "@tiptap/extension-link": "^3.30.3",
    "@tiptap/react": "^3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "1.38.2",
    "@vercel/analytics": "^2.0.1",
    "d3-hierarchy": "^3.1.2",
    "framer-motion": "^11.18.2",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "js-scroll-effect-module": "^0.13.5",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.577.0",
    "negotiator": "^1.1.0",
    "next": "16.3.2",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "pusher": "5.3.4",
    "pusher-js": "8.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^15.0.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^29.5.14",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.8",
    "jest-environment-jsdom": "^30.4.1",
    "jest-junit": "17.0.0",
    "jscpd": "5.0.16",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@swc/helpers": "0.5.23",
    "glob": "^11.0.0",
    "picomatch": "^2.3.2",
    "ip-address": "^10.1.1",
    "ws": "^8.21.0",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "next-auth": {
      "next": "$next"
    }
  }
}
