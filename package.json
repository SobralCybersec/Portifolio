    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sharp": "^0.35.4",
    "three": "^0.185.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "unist-util-visit-parents": "^6.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@emotion/is-prop-valid": "^1.4.0",
    "@eslint/compat": "^2.1.0",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.3.3",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/hast": "^3.0.5",
    "@types/jest": "^30.0.0",
    "@types/mdx": "^2.0.14",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "0.185.4",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.4",
    "jest": "^30.5.0",
    "jest-canvas-mock": "^2.5.8",
    "jest-environment-jsdom": "^30.5.0",
    "jest-junit": "17.0.0",
    "jscpd": "5.0.16",
    "jsdom": "28.0.0",
    "postcss": "^8.5.26",
    "storybook": "^10.6.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@swc/helpers": "0.5.23",
    "test-exclude": "^8.0.0",
    "picomatch": "^2.3.2",
    "ip-address": "^10.1.1",
    "ws": "^8.21.0",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4",
    "jsdom": "28.0.0",
    "chrome-launcher": "1.2.1",
    "lighthouse": "13.4.1",
    "qs": "6.16.0",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "next-auth": {
      "next": "$next"
    }
  }
}
